// version_info.rc.in - Windows VERSIONINFO template for AHKDeck.exe.
// Configured by CMake (configure_file @ONLY) from project(... VERSION):
// the single source of truth for the version is CMakeLists.txt project() /
// core/Version.h (test_version.cpp pins both sides). Do not hand-edit the
// generated .rc - it is an intermediate under .temp.
// Keep this template ASCII-only: rc.exe parses in the active code page and
// Chinese strings here would need code-page pragmas (ship gate later).

// Application icon (m030): the AutoHotkey "H" from the pinned v2.0.25 source
// (GPL-2.0, same license; attribution in THIRD-PARTY-NOTICES.md). CMake copies
// DeckIcon.h and autohotkey.ico next to this generated .rc, so both paths stay
// relative and the template never embeds a local absolute path.
#include "DeckIcon.h"
IDI_AHKDECK ICON "autohotkey.ico"

// About-dialog donation QR codes (m079), embedded so the shipped exe needs no
// loose image files. Same author's codes as the pecia project; CMake copies
// both SVGs next to this generated .rc.
ID_QR_WECHAT RCDATA "WeChatPay.svg"
ID_QR_ALIPAY RCDATA "ALiPay.svg"

// NOTE: resource ID must be the literal 1 (RT_VERSION id 1). Do NOT write
// "VS_VERSION_INFO" here without including winver.h - unresolved, rc.exe
// compiles it as a STRING-NAMED resource and GetFileVersionInfo finds nothing
// (first build shipped exactly that bug: strings in the exe, empty properties).
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AHKDeck Project"
            VALUE "FileDescription", "AHKDeck"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "AHKDeck"
            VALUE "LegalCopyright", "GPL-2.0"
            VALUE "OriginalFilename", "AHKDeck.exe"
            VALUE "ProductName", "AHKDeck"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
